<Project Sdk="Microsoft.NET.Sdk">

  <!--
    このマシンはオフラインで、NuGet オフラインフィードに xunit / MSTest の
    テスト SDK 一式が揃わない(Microsoft.NET.Test.Sdk が NuGet.Frameworks 5.x を要求するが
    4.6.4 しか無い)。そのため依存パッケージゼロの自前ランナーにしている。
    実行: dotnet run (project tests)   終了コード = 失敗数
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OpenFolder.Tests</AssemblyName>
    <RootNamespace>OpenFolder.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\open-folder.csproj" />
  </ItemGroup>

</Project>
